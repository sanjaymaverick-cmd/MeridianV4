# Copy to .env locally. Never commit secrets.

MERIDIAN_ROOT=
MERIDIAN_MODE=dry
# dry | paper | live
MERIDIAN_LOOP=0
MERIDIAN_MAX_TICKS=0
MERIDIAN_POLL_SEC=30
MERIDIAN_SYMBOLS=INFY,HCLTECH,RELIANCE,TCS,BNBUSDT
MERIDIAN_LIVE_OK=0

# Injected automatically when hosted under OpenAlgo /python
OPENALGO_API_KEY=
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_WEBHOOK_ID=
OPENALGO_USERNAME=
STRATEGY_NAME=MeridianV4

# Optional risk overlays (defaults are production values)
# MERIDIAN_MIN_META_PROB=0.55
# MERIDIAN_MAX_HEAT=0.35
# MERIDIAN_DAILY_LOSS_LIMIT=-5000
# MERIDIAN_LIVE_BUDGET=25000
# MERIDIAN_PAPER_BUDGET=100000
